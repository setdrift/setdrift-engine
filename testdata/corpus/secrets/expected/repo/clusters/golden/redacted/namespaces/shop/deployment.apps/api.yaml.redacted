apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: shop
spec:
  selector:
    matchLabels:
      app: api
  template:
    metadata:
      labels:
        app: api
    spec:
      containers:
      - env:
        - name: DB_PASSWORD
          value: SETDRIFT_REDACTED
        - name: LOG_LEVEL
          value: info
        - name: DB_USER
          valueFrom:
            secretKeyRef:
              key: username
              name: db-creds
        image: ghcr.io/example/api:2
        name: api
