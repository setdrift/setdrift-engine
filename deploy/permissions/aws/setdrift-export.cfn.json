{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SetDrift: the IAM policy setdrift export --aws needs for one EKS cluster, and optionally an EKS access entry giving a principal the setdrift-export or setdrift-verify Kubernetes group (apply deploy/permissions/kubernetes/ in the cluster for the group's role). See docs/permissions-aws.md.",
  "Parameters": {
    "ClusterName": {
      "Type": "String",
      "Description": "The EKS cluster's name"
    },
    "RoleName": {
      "Type": "String",
      "Default": "",
      "Description": "An IAM role to attach the policy to, by name; empty attaches it to nothing"
    },
    "PrincipalArn": {
      "Type": "String",
      "Default": "",
      "Description": "An IAM role or user ARN to give an EKS access entry; empty creates none. It must not have an access entry already"
    },
    "KubernetesGroup": {
      "Type": "String",
      "Default": "setdrift-export",
      "AllowedValues": [
        "setdrift-export",
        "setdrift-verify"
      ],
      "Description": "The Kubernetes group the access entry gives: setdrift-export for export and diff, setdrift-verify for verify too"
    }
  },
  "Conditions": {
    "HasRole": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "RoleName"
            },
            ""
          ]
        }
      ]
    },
    "HasPrincipal": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PrincipalArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "ExportPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": {
          "Fn::Sub": "setdrift export --aws for EKS cluster ${ClusterName}"
        },
        "Roles": {
          "Fn::If": [
            "HasRole",
            [
              {
                "Ref": "RoleName"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "Cluster",
              "Effect": "Allow",
              "Action": [
                "eks:DescribeCluster",
                "eks:ListPodIdentityAssociations",
                "eks:ListAccessEntries",
                "eks:ListAddons"
              ],
              "Resource": {
                "Fn::Sub": "arn:aws:eks:${AWS::Region}:${AWS::AccountId}:cluster/${ClusterName}"
              }
            },
            {
              "Sid": "ClusterParts",
              "Effect": "Allow",
              "Action": [
                "eks:DescribePodIdentityAssociation",
                "eks:DescribeAccessEntry",
                "eks:ListAssociatedAccessPolicies",
                "eks:DescribeAddon"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:eks:${AWS::Region}:${AWS::AccountId}:podidentityassociation/${ClusterName}/*"
                },
                {
                  "Fn::Sub": "arn:aws:eks:${AWS::Region}:${AWS::AccountId}:access-entry/${ClusterName}/*"
                },
                {
                  "Fn::Sub": "arn:aws:eks:${AWS::Region}:${AWS::AccountId}:addon/${ClusterName}/*"
                }
              ]
            },
            {
              "Sid": "Roles",
              "Effect": "Allow",
              "Action": "iam:GetRole",
              "Resource": {
                "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/*"
              }
            },
            {
              "Sid": "Describe",
              "Effect": "Allow",
              "Action": [
                "ec2:DescribeSubnets",
                "ec2:DescribeVolumes",
                "ec2:DescribeVpcs"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    },
    "AccessEntry": {
      "Type": "AWS::EKS::AccessEntry",
      "Condition": "HasPrincipal",
      "Properties": {
        "ClusterName": {
          "Ref": "ClusterName"
        },
        "PrincipalArn": {
          "Ref": "PrincipalArn"
        },
        "Type": "STANDARD",
        "KubernetesGroups": [
          {
            "Ref": "KubernetesGroup"
          }
        ]
      }
    }
  },
  "Outputs": {
    "PolicyArn": {
      "Description": "The policy, to attach to whoever runs setdrift export --aws",
      "Value": {
        "Ref": "ExportPolicy"
      }
    }
  }
}
